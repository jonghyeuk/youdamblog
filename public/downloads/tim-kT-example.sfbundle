{
  "bundle_type": "semifab.model_submission",
  "schema_version": "0.1",
  "created_at": "2026-08-10T08:58:07.865Z",
  "object_id": "user.example.tim-kt",
  "files": {
    "manifest.json": {
      "schema_version": "0.1",
      "object_id": "user.example.tim-kt",
      "version": "0.1.0",
      "visibility": "private",
      "model_type": "replaceable_function",
      "scientific_status": "REPORTED",
      "title": "Example temperature-dependent TIM conductivity"
    },
    "model.json": {
      "governing_relation": "R_TIM(T) = thickness / (k_TIM(T) * area)",
      "implementation": {
        "kind": "linear_function",
        "expression": "k = k_ref + slope * (T - T_ref)"
      },
      "parameters": {
        "k_ref": 3.2,
        "T_ref": 25,
        "slope": -0.008
      }
    },
    "quantities.json": {
      "inputs": [
        {
          "name": "temperature",
          "unit": "degC",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "thermal_conductivity",
          "unit": "W/(m*K)",
          "type": "number"
        }
      ]
    },
    "validity.json": {
      "domains": [
        {
          "quantity": "temperature",
          "min": 20,
          "max": 120,
          "unit": "degC",
          "status": "REPORTED"
        }
      ],
      "extrapolation": "forbidden_by_default"
    },
    "evidence.json": {
      "claims": [
        {
          "id": "claim.example.tim-k-decreases",
          "status": "REPORTED",
          "evidence_refs": [
            "evidence.example-001"
          ]
        }
      ],
      "evidence": [
        {
          "id": "evidence.example-001",
          "type": "user_document",
          "title": "Replace with actual source",
          "license": "UNKNOWN"
        }
      ]
    },
    "test-vectors.json": {
      "vectors": [
        {
          "input": {
            "temperature": 25
          },
          "expected": {
            "thermal_conductivity": 3.2
          },
          "tolerance": 0.001
        },
        {
          "input": {
            "temperature": 75
          },
          "expected": {
            "thermal_conductivity": 2.8
          },
          "tolerance": 0.001
        }
      ]
    }
  },
  "sha256": "4add06d8c0bbf8dbf8162a146099eeb76c59633ff0b6acc42f6a094c653cbbfc"
}
