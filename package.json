{
  "name": "yudam-life-blog",
  "version": "1.0.0",
  "description": "고등학생 과학논문 코칭 - 10년 경력 대학 강사의 논문 작성 가이드",
  "main": "public/index.html",
  "scripts": {
    "prebuild": "node scripts/generate-static-pages.js",
    "build": "npm run prebuild && npm run generate-sitemap",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "serve": "firebase serve",
    "deploy": "npm run build && firebase deploy",
    "start": "firebase serve --only hosting",
    "init": "firebase init"
  },
  "keywords": [
    "과학논문",
    "고등학생",
    "R&E",
    "논문작성법",
    "과학탐구",
    "대입준비"
  ],
  "author": "Yudam",
  "license": "MIT",
  "devDependencies": {
    "firebase-tools": "^13.0.0"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "sitemap": "^7.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/yudam-life-blog"
  },
  "homepage": "https://youdam.com"
}
