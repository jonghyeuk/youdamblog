{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semifab.local/schemas/model-submission-manifest-v0.1.json",
  "type": "object",
  "required": ["schema_version", "object_id", "version", "visibility", "model_type", "scientific_status"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "object_id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "version": { "type": "string" },
    "visibility": { "enum": ["private", "team", "public_candidate"] },
    "model_type": { "enum": ["governing_physics", "parameterized_model", "replaceable_function", "data_model", "external_solver"] },
    "scientific_status": { "enum": ["UNVERIFIED", "REPORTED", "BENCHMARKED", "CALIBRATED", "VALIDATED"] }
  }
}
