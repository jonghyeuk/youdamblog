rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // posts 컬렉션
    match /posts/{postId} {
      // 읽기: 누구나 가능 (블로그 공개 글)
      allow read: if true;

      // 쓰기: Firebase 인증된 사용자만 가능
      allow create, update, delete: if request.auth != null;
    }

    // 그 외 모든 컬렉션: 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
